{
    "expo": {
        "name": "Sprinter Analysis",
        "slug": "sprinter-analysis",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "sprinter",
        "userInterfaceStyle": "dark",
        "splash": {
            "image": "./assets/images/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#000000"
        },
        "assetBundlePatterns": [
            "**/*"
        ],
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/icon.png",
                "backgroundColor": "#000000"
            }
        },
        "plugins": [
            "expo-router"
        ]
    }
}